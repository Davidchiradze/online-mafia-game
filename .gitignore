# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.credentials

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is committed (not ignored) so `tsc --noEmit` in CI can resolve
# Next's ambient types — notably static image imports (*.png). It is normally
# generated by `next dev`/`next build`; the committed copy keeps CI == local.
