# See https://help.github.com/articles/ignoring-files/ for more about ignoring files.

# dependencies
/node_modules
/.pnp
.pnp.*
.yarn/*
!.yarn/patches
!.yarn/plugins
!.yarn/releases
!.yarn/versions

# testing
/coverage

# next.js
/.next/
/out/

# production
/build

# misc
.DS_Store
*.pem

# debug
npm-debug.log*
yarn-debug.log*
yarn-error.log*
.pnpm-debug.log*

# env files (can opt-in for committing if needed)
.env*
.credentials

# vercel
.vercel

# typescript
*.tsbuildinfo
# next-env.d.ts is committed (not ignored) so `tsc --noEmit` in CI can resolve
# Next's ambient types — notably static image imports (*.png). It is normally
# generated by `next dev`/`next build`; the committed copy keeps CI == local.

# graphify — the knowledge graph is a local build artifact, not a source of
# truth. Upstream suggests committing graphify-out/, but the post-commit hook
# rebuilds it on EVERY commit and graph.json is ~2.4MB, so committing it would
# add a multi-megabyte diff to history each time. A full rebuild is 8s and free
# (local AST, no API calls): `graphify extract . --code-only`.
# To share the graph with the team instead, un-ignore graph.json + manifest.json
# + GRAPH_REPORT.md and have every dev run `graphify hook install` so the
# graph.json merge driver in .gitattributes actually resolves.
graphify-out/

# graphify writes this when it edits .claude/settings.json
*.graphify-bak

# graphify's git hooks embed an absolute path to the interpreter graphify was
# installed under (e.g. ~/.local/share/uv/tools/graphifyy/bin/python), so they
# are machine-specific and must not be committed. pre-push IS committed and is
# unaffected. Each dev opts in locally with `graphify hook install`.
.githooks/post-commit
.githooks/post-checkout
