#!/bin/sh
#
# Pre-push hook — runs the same checks as CI (typecheck + unit tests) so broken
# code never leaves your machine.
#
# Wired via `core.hooksPath=.githooks`, set automatically by the `prepare` npm
# script on `npm install`. To activate manually: git config core.hooksPath .githooks
#
# Bypass in an emergency with:  git push --no-verify
#
set -e

echo "pre-push ▸ typecheck (tsc --noEmit)…"
npm run --silent typecheck

echo "pre-push ▸ unit tests (vitest)…"
npm test

# Convex codegen drift check.
#
# WHY: convex/_generated is committed and tsconfig sets skipLibCheck:true, so a
# moved Convex module leaves api.d.ts importing a path that no longer exists —
# and `tsc` stays GREEN (verified: exit 0). Regenerating here catches it locally.
#
# `convex codegen` needs deployment credentials and performs a network push, so
# it cannot run in CI and is skipped unless CONVEX_DEPLOYMENT is set. The
# offline equivalent (the `_generated` drift assertion in
# tests/convex/apiIntegrity.test.ts) runs unconditionally via `npm test` above.
#
# ⚠️ DEV DEPLOYMENT ONLY — never point CONVEX_DEPLOYMENT at prod for this.
if [ -n "$CONVEX_DEPLOYMENT" ]; then
  echo "pre-push ▸ convex codegen drift ($CONVEX_DEPLOYMENT)…"
  if ! npm run --silent codegen:check; then
    echo ""
    echo "pre-push ✖ convex/_generated is stale."
    echo "          Run 'npm run codegen' and commit the result."
    exit 1
  fi
else
  echo "pre-push ▸ skipping codegen drift check (CONVEX_DEPLOYMENT not set)"
fi

echo "pre-push ▸ all checks passed ✔"
